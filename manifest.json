{
  "schemaVersion": 1,
  "id": "io.github.rkrdeano.logitech",
  "name": "Logitech",
  "version": "1.0.0",
  "author": "rkrdeano",
  "license": "MIT",
  "description": "Logitech Unifying and Bolt receivers in the Omarchy bar: device battery, pairing, and unpairing.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Logitech",
    "description": "Show paired Logitech devices and their battery, and pair or unpair devices from the bar.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 120,
      "showBattery": true,
      "lowBatteryPercent": 20,
      "hideWhenNoReceiver": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "description": "Polling a receiver wakes its devices, so keep this generous.",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 120
      },
      {
        "key": "showBattery",
        "type": "boolean",
        "label": "Show the lowest battery level next to the bar icon",
        "defaultValue": true
      },
      {
        "key": "lowBatteryPercent",
        "type": "integer",
        "label": "Low battery warning threshold (%)",
        "min": 0,
        "max": 100,
        "step": 5,
        "defaultValue": 20
      },
      {
        "key": "hideWhenNoReceiver",
        "type": "boolean",
        "label": "Hide the icon when no receiver is plugged in",
        "defaultValue": true
      }
    ]
  }
}
