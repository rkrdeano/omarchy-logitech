#!/usr/bin/env python3
"""Emit a JSON snapshot of every Logitech receiver and paired device.

Uses Solaar's logitech_receiver library rather than parsing `solaar show`,
which prints several hundred lines of feature dumps per device and takes
seconds. Only the fields the bar widget paints are read here.
"""

import json
import sys

try:
    from logitech_receiver import base
    from logitech_receiver import device as _device
    from logitech_receiver import receiver as _receiver
except Exception as exc:  # solaar not installed, or an incompatible version
    json.dump({"error": "solaar library unavailable: %s" % exc, "receivers": []}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def battery_of(dev):
    """Battery as {level, status, charging} — None when the device won't say."""
    try:
        battery = dev.battery()
    except Exception:
        return None
    if battery is None:
        return None
    level = getattr(battery, "level", None)
    status = getattr(battery, "status", None)
    status_text = str(status) if status is not None else ""
    # Solaar renders approximate levels as NamedInt words ("full", "good", ...)
    # and exact ones as ints; keep both shapes apart for the UI.
    percent = None
    approximate = ""
    if level is not None:
        try:
            percent = int(level)
            if str(level) != str(percent):  # a NamedInt: has a word form too
                approximate = str(level)
        except Exception:
            approximate = str(level)
    status_lower = status_text.lower()
    return {
        "percent": percent,
        "approximate": approximate,
        "status": status_text.split(".")[-1].replace("_", " ").lower(),
        # "discharging" contains "charging", so match the recharge words only.
        "charging": "recharg" in status_lower or status_lower.startswith("charging"),
    }


def describe_device(dev, number=None):
    try:
        online = bool(dev.ping())
    except Exception:
        online = False
    out = {
        "number": int(number if number is not None else getattr(dev, "number", 0) or 0),
        "name": str(getattr(dev, "name", "") or "Unknown device"),
        "codename": str(getattr(dev, "codename", "") or ""),
        "kind": str(getattr(dev, "kind", "") or "").lower(),
        "serial": str(getattr(dev, "serial", "") or ""),
        "wpid": str(getattr(dev, "wpid", "") or ""),
        "online": online,
        "battery": battery_of(dev) if online else None,
    }
    return out


def describe_receiver(rcv):
    devices = []
    try:
        for dev in rcv:
            if dev is not None:
                devices.append(describe_device(dev))
    except Exception:
        pass
    devices.sort(key=lambda d: d["number"])
    try:
        paired = int(rcv.count())
    except Exception:
        paired = len(devices)
    try:
        maximum = int(rcv.max_devices or 0)
    except Exception:
        maximum = 0
    try:
        remaining = rcv.remaining_pairings()
        remaining = int(remaining) if remaining is not None and remaining >= 0 else None
    except Exception:
        remaining = None
    return {
        "name": str(getattr(rcv, "name", "") or "Logitech Receiver"),
        "path": str(getattr(rcv, "path", "") or ""),
        "serial": str(getattr(rcv, "serial", "") or ""),
        "kind": str(getattr(rcv, "receiver_kind", "") or ""),
        "paired": paired,
        "maxDevices": maximum,
        # A Bolt receiver's pairing slots are finite; None means "not reported".
        "remainingPairings": remaining,
        "canPair": maximum > paired if maximum else True,
        "devices": devices,
    }


def main():
    receivers = []
    wired = []
    errors = []
    for dev_info in base.receivers_and_devices():
        try:
            if getattr(dev_info, "isDevice", False):
                dev = _device.create_device(base, dev_info)
                if dev is not None:
                    entry = describe_device(dev)
                    entry["path"] = str(getattr(dev, "path", "") or "")
                    wired.append(entry)
            else:
                rcv = _receiver.create_receiver(base, dev_info)
                if rcv is not None:
                    receivers.append(describe_receiver(rcv))
        except Exception as exc:
            errors.append("%s: %s" % (getattr(dev_info, "path", "?"), exc))
    json.dump({"receivers": receivers, "devices": wired, "errors": errors}, sys.stdout)
    sys.stdout.write("\n")


main()
